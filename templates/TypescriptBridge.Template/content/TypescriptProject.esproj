<Project Sdk="Microsoft.VisualStudio.JavaScript.SDK/1.0.6887863">

  <PropertyGroup>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <StartupCommand>node "$(MSBuildProjectDirectory)\server.js" --f5</StartupCommand>

    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultTypeScriptConfigurationItems>false</EnableDefaultTypeScriptConfigurationItems>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" />
    <None Include="config.json" />
    <None Include="ts\tsconfig.json" />
    <None Include="ts\package.json" />
    <None Include="ts\src\**\*.ts" Exclude="ts\src\default-definitions\**" />
  </ItemGroup>

  <Target Name="PrepareDebugSession" BeforeTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Prepare-DebugSession.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="false" />
  </Target>

</Project>

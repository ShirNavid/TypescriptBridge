{
  "output": {
    "className": "TypescriptProvider"
  },
  "bundle": {
    "format": "iife"
  },
  "release-minify": {
    "level": "aggressive",
    "keepNames": true
  },
  "run": {
    "browser": "edge",
    "port": 45000,
    "entrypoint": "main"
  },
  "isTestProject": false,
  "testEntrypoint": "tests/index.ts",
  "entrypoints": {
    "main": {
      "fieldName": "TypescriptCode",
      "source": "src/app.ts"
    }
  }
}

<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6165494">

  <PropertyGroup>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>

    <!--
      The .esproj is the Visual Studio debug-launch project for the
      TypescriptBridge executable. When F5 is pressed on this project:

        1. PrepareDebugSession target regenerates .vscode/launch.json
           from .vscode/launch.template.json using the port and browser
           values from config.json.
        2. StartupCommand starts the C# host (which starts the HTTP
           server and prepares the debug session).
        3. launch.json tells Visual Studio's JavaScript debugger which
           URL to open and how to attach.

      This is the architecture confirmed by C0-Report.
    -->
    <StartupCommand>dotnet run --project "$(MSBuildProjectDirectory)\TypescriptProject.csproj"</StartupCommand>
  </PropertyGroup>

  <!--
    Before each debug session, regenerate .vscode/launch.json from the
    template, substituting the port and browser from config.json.

    Visual Studio re-reads launch.json on every F5, so this substitution
    takes effect on the next F5 without a Visual Studio restart.
  -->
  <Target Name="PrepareDebugSession" BeforeTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Prepare-DebugSession.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="false" />
  </Target>

</Project>

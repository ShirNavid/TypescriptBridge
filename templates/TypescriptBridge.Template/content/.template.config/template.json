{
  "$schema": "http://json.schemastore.org/template",
  "classifications": [
    "TypeScript",
    "Library"
  ],
  "identity": "TypescriptBridge.Template.ClassLib",
  "name": "Typescript Project",
  "shortName": "typescript-bridge",
  "sourceName": "TypescriptProject",
  "preferNameDirectory": true,
  "defaultName": "TypescriptProject",
  "description": "A class library project that lets you write TypeScript and consume it as a C# readonly string field at build time.",
  "tags": {
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        {
          "rename": {
            "Bridge.cs.template": "Bridge.cs"
          }
        }
      ]
    }
  ],
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net8.0",
          "description": "Target .NET 8"
        },
        {
          "choice": "net9.0",
          "description": "Target .NET 9"
        },
        {
          "choice": "net10.0",
          "description": "Target .NET 10"
        }
      ],
      "defaultValue": "net8.0",
      "replaces": "net8.0"
    }
  }
}

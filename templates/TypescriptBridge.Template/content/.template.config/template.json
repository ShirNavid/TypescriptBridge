{
  "$schema": "http://json.schemastore.org/template",
  "classifications": [
    "TypeScript",
    "Library"
  ],
  "identity": "TypescriptBridge.Template.ClassLib",
  "name": "Typescript Project",
  "shortName": "typescript-bridge",
  "sourceName": "TypescriptProject",
  "preferNameDirectory": true,
  "defaultName": "MyApp",
  "description": "A TypescriptBridge project. Write TypeScript in ts/app.ts and debug it in Visual Studio with full breakpoints. The compiled JavaScript is embedded into a C# readonly string field that other C# projects can consume.",
  "tags": {
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        {
          "rename": {
            "Bridge.cs.template": "Bridge.cs",
            "_vscode/launch.template.json": ".vscode/launch.template.json",
            "Prepare-DebugSession.ps1.template": "Prepare-DebugSession.ps1"
          }
        }
      ]
    }
  ],
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        { "choice": "net8.0",  "description": "Target .NET 8" },
        { "choice": "net9.0",  "description": "Target .NET 9" },
        { "choice": "net10.0", "description": "Target .NET 10" }
      ],
      "defaultValue": "net8.0",
      "replaces": "net8.0"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ts-handler.dev/schema/v1.json",
  "title": "TsHandler Configuration",
  "description": "Configuration for the TsHandler build integration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "typescript"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Configuration schema version. Currently must be 1."
    },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "description": "ECMAScript target version.",
          "enum": [
            "es2015", "es2016", "es2017", "es2018", "es2019",
            "es2020", "es2021", "es2022", "esnext"
          ],
          "default": "es2020"
        },
        "format": {
          "type": "string",
          "description": "Output module format. Use 'iife' for direct <script> embedding.",
          "enum": ["iife", "esm", "cjs"],
          "default": "iife"
        }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable inline source map generation for Debug builds.",
              "default": true
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "type": "string",
              "description": "Minification level. off = no minify, light = remove whitespace, full = whitespace + syntax, aggressive = whitespace + syntax + rename identifiers.",
              "enum": ["off", "light", "full", "aggressive"],
              "default": "aggressive"
            },
            "keepNames": {
              "type": "boolean",
              "description": "Preserve function and class names when mangling. Only applies when level is aggressive.",
              "default": false
            }
          }
        }
      }
    }
  }
}
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <PackageId>TypescriptBridge.Build</PackageId>
    <Authors>ShirNavid</Authors>
    <Description>MSBuild integration for TypescriptBridge. Compiles TypeScript into C# readonly fields at build time, with full JSON Schema-based IntelliSense and validation.</Description>
    <PackageTags>typescript;msbuild;build;codegen;schema;esbuild</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ShirNavid/TypescriptBridge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShirNavid/TypescriptBridge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build\TypescriptBridge.Build.targets"
          Pack="true"
          PackagePath="build\TypescriptBridge.Build.targets" />

    <None Include="schema\config.schema.json"
          Pack="true"
          PackagePath="tools\schema\config.schema.json" />

    <None Include="..\TypescriptBridge.Tool\bin\$(Configuration)\net8.0\**\*"
          Pack="true"
          PackagePath="tools\net8.0\any\"
          Exclude="..\TypescriptBridge.Tool\bin\$(Configuration)\net8.0\**\*.pdb" />

    <None Include="..\..\tools\esbuild\win-x64\esbuild.exe"
          Pack="true"
          PackagePath="tools\esbuild\win-x64\esbuild.exe" />

    <None Include="..\..\README.md"
          Pack="true"
          PackagePath="\" />

    <None Include="icon.png"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>





<Project>

  <!--
    TypescriptBridge.Build.targets

    This file is packed into the TypescriptBridge.Build NuGet package
    and is automatically imported by NuGet into any project that
    references the package.

    Responsibilities:

      1. Run the TypescriptBridge.Tool at build time to produce Bridge.cs
         from the user's ts/src/app.ts, before the C# compiler runs.

      2. Copy the Tool payload and the esbuild binary from the NuGet
         package into a stable location inside the consuming project:
             obj/TypescriptBridge/tools/net8.0/any/
             obj/TypescriptBridge/tools/esbuild/win-x64/
         This stable location is used by:
             the Tool itself (via the esbuild argument)
             server.js (in the generated .esproj project)
             any direct-run scenario

    Contract with the Tool:
      config path          config.json
      project path         project directory
      intermediate path    intermediate output directory
      esbuild path         esbuild binary
      configuration name   Debug or Release
  -->

  <PropertyGroup>
    <!-- Location of the Tool DLL shipped in the NuGet package. -->
    <TypescriptBridgeToolPath Condition="'$(TypescriptBridgeToolPath)' == ''">$(MSBuildThisFileDirectory)..\tools\net8.0\any\TypescriptBridge.Tool.dll</TypescriptBridgeToolPath>

    <!-- Location of the esbuild binary shipped in the NuGet package. -->
    <TypescriptBridgeEsbuildSourcePath Condition="'$(TypescriptBridgeEsbuildSourcePath)' == ''">$(MSBuildThisFileDirectory)..\tools\esbuild\win-x64\esbuild.exe</TypescriptBridgeEsbuildSourcePath>

    <!-- Path to the user's config.json inside the consuming project. -->
    <TypescriptBridgeConfigPath Condition="'$(TypescriptBridgeConfigPath)' == ''">$(MSBuildProjectDirectory)\config.json</TypescriptBridgeConfigPath>

    <!-- Path to the user's tsconfig.json. -->
    <TypescriptBridgeTsConfigPath Condition="'$(TypescriptBridgeTsConfigPath)' == ''">$(MSBuildProjectDirectory)\ts\tsconfig.json</TypescriptBridgeTsConfigPath>

    <!-- Path to the user's TypeScript entry point. -->
    <TypescriptBridgeEntryPoint Condition="'$(TypescriptBridgeEntryPoint)' == ''">$(MSBuildProjectDirectory)\ts\src\app.ts</TypescriptBridgeEntryPoint>

    <!-- Intermediate directory for the tool's scratch files. -->
    <TypescriptBridgeIntermediatePath Condition="'$(TypescriptBridgeIntermediatePath)' == ''">$(BaseIntermediateOutputPath)TypescriptBridge</TypescriptBridgeIntermediatePath>

    <!--
      Stable project-local directory where the Tool payload and esbuild
      binary are copied for use by server.js and by any direct-run flow.

      This directory lives under obj/ so it is gitignored and is not
      visible in Solution Explorer.
    -->
    <TypescriptBridgeLocalToolsRoot Condition="'$(TypescriptBridgeLocalToolsRoot)' == ''">$(BaseIntermediateOutputPath)TypescriptBridge\tools</TypescriptBridgeLocalToolsRoot>

    <TypescriptBridgeLocalToolDir>$(TypescriptBridgeLocalToolsRoot)\net8.0\any</TypescriptBridgeLocalToolDir>
    <TypescriptBridgeLocalEsbuildDir>$(TypescriptBridgeLocalToolsRoot)\esbuild\win-x64</TypescriptBridgeLocalEsbuildDir>

    <TypescriptBridgeLocalEsbuildPath>$(TypescriptBridgeLocalEsbuildDir)\esbuild.exe</TypescriptBridgeLocalEsbuildPath>

    <!--
      Normalize trailing separators so that the value can be safely
      embedded inside quotes on the command line. A trailing backslash
      would escape the closing quote and corrupt the next argument.
    -->
    <TypescriptBridgeIntermediatePath>$(TypescriptBridgeIntermediatePath.TrimEnd('\'))</TypescriptBridgeIntermediatePath>
    <TypescriptBridgeLocalToolDir>$(TypescriptBridgeLocalToolDir.TrimEnd('\'))</TypescriptBridgeLocalToolDir>
    <TypescriptBridgeLocalEsbuildDir>$(TypescriptBridgeLocalEsbuildDir.TrimEnd('\'))</TypescriptBridgeLocalEsbuildDir>
  </PropertyGroup>

  <!--
    Copy the Tool payload and the esbuild binary from the NuGet package
    into the stable project-local location.

    This target runs before TypescriptBridgeGenerate so that the Tool
    can be invoked from the stable location and so that server.js can
    find esbuild there during F5.
  -->
  <Target Name="TypescriptBridgePrepareTools"
          BeforeTargets="TypescriptBridgeGenerate;BeforeCompile;CoreCompile">

    <PropertyGroup>
      <_TSBPackagedToolRoot>$(MSBuildThisFileDirectory)..\tools\net8.0\any\</_TSBPackagedToolRoot>
      <_TSBPackagedEsbuildRoot>$(MSBuildThisFileDirectory)..\tools\esbuild\win-x64\</_TSBPackagedEsbuildRoot>
    </PropertyGroup>

    <ItemGroup>
      <_TSBPackagedToolFiles Include="$(_TSBPackagedToolRoot)**\*" />
      <_TSBPackagedEsbuildFiles Include="$(_TSBPackagedEsbuildRoot)*" />
    </ItemGroup>

    <MakeDir Directories="$(TypescriptBridgeLocalToolDir);$(TypescriptBridgeLocalEsbuildDir)" />

    <Copy SourceFiles="@(_TSBPackagedToolFiles)"
          DestinationFiles="@(_TSBPackagedToolFiles->'$(TypescriptBridgeLocalToolDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(_TSBPackagedEsbuildFiles)"
          DestinationFiles="@(_TSBPackagedEsbuildFiles->'$(TypescriptBridgeLocalEsbuildDir)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Run the Tool before the C# compiler.
  -->
  <Target Name="TypescriptBridgeGenerate"
          BeforeTargets="BeforeCompile;CoreCompile"
          DependsOnTargets="TypescriptBridgePrepareTools"
          Inputs="$(TypescriptBridgeEntryPoint);$(TypescriptBridgeConfigPath);$(TypescriptBridgeTsConfigPath)"
          Outputs="$(MSBuildProjectDirectory)\Bridge.cs">

    <Message Importance="high" Text="TypescriptBridge: generating Bridge.cs from ts/src/app.ts" />

    <MakeDir Directories="$(TypescriptBridgeIntermediatePath)" />

    <Exec Command="dotnet exec &quot;$(TypescriptBridgeToolPath)&quot; --config &quot;$(TypescriptBridgeConfigPath)&quot; --project &quot;$(MSBuildProjectDirectory)&quot; --intermediate &quot;$(TypescriptBridgeIntermediatePath)&quot; --configuration &quot;$(Configuration)&quot; --esbuild &quot;$(TypescriptBridgeLocalEsbuildPath)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="false" />

    <ItemGroup>
      <FileWrites Include="$(MSBuildProjectDirectory)\Bridge.cs" />
    </ItemGroup>

  </Target>

</Project>

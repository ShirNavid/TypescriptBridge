<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>


    <PackageId>TypescriptBridge.DebugHost</PackageId>
    <Description>Runtime hosting and browser-launch helpers for TypescriptBridge.</Description>
    <PackageTags>typescript;debug;browser;web</PackageTags>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- The DebugHost library does not produce a NuGet package by default.
         Packaging happens in the final release step. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

</Project>



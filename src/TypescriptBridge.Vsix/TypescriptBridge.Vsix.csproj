<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>false</VsixDeployOnDebug>

    <PackageId>TypescriptBridge.Vsix</PackageId>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Authors>ShirNavid</Authors>
    <Description>Debug TypeScript in Visual Studio with breakpoints from a single C# library project.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <!--
    The Visual Studio installation path.

    When building from inside Visual Studio, VsInstallRoot is set
    automatically. When building from the command line with dotnet
    build, it is empty. In that case we fall back to a known-good
    path for Visual Studio 2026 Community.

    Override VsInstallRoot on the command line if Visual Studio is
    installed elsewhere.
  -->
  <PropertyGroup>
    <VsInstallRootFallback Condition="'$(VsInstallRootFallback)' == ''">C:\Program Files\Microsoft Visual Studio\18\Community</VsInstallRootFallback>
    <EffectiveVsInstallRoot Condition="'$(VsInstallRoot)' != ''">$(VsInstallRoot)</EffectiveVsInstallRoot>
    <EffectiveVsInstallRoot Condition="'$(EffectiveVsInstallRoot)' == ''">$(VsInstallRootFallback)</EffectiveVsInstallRoot>
  </PropertyGroup>

  <!--
    BridgeSchemaProvider and BridgeSchemaSelector are temporarily
    excluded from the compile set.

    They depend on a TypescriptBridge.Vsix.Browser folder that has not
    been created yet. They will be restored in a later development
    phase once that folder is in place.

    During Phase 1 the VSIX only needs to build and register the
    launch profile provider.
  -->
  <ItemGroup>
    <Compile Remove="BridgeSchemaProvider.cs" />
    <Compile Remove="BridgeSchemaSelector.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="System.ComponentModel.Composition" Version="9.0.0" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.38461" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />

    <Reference Include="Microsoft.WebTools.Languages.Json"
               Condition="Exists('$(EffectiveVsInstallRoot)\Common7\IDE\Extensions\Microsoft\Web Tools\Languages\Microsoft.WebTools.Languages.Json.dll')">
      <HintPath>$(EffectiveVsInstallRoot)\Common7\IDE\Extensions\Microsoft\Web Tools\Languages\Microsoft.WebTools.Languages.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Microsoft.VisualStudio.ProjectSystem"
               Condition="Exists('$(EffectiveVsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\Project\Microsoft.VisualStudio.ProjectSystem.dll')">
      <HintPath>$(EffectiveVsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\Project\Microsoft.VisualStudio.ProjectSystem.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Microsoft.VisualStudio.ProjectSystem.VS"
               Condition="Exists('$(EffectiveVsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\Project\Microsoft.VisualStudio.ProjectSystem.VS.dll')">
      <HintPath>$(EffectiveVsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\Project\Microsoft.VisualStudio.ProjectSystem.VS.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Microsoft.VisualStudio.ProjectSystem.Managed.VS"
               Condition="Exists('$(EffectiveVsInstallRoot)\Common7\IDE\Extensions\Microsoft\ManagedProjectSystem\Microsoft.VisualStudio.ProjectSystem.Managed.VS.dll')">
      <HintPath>$(EffectiveVsInstallRoot)\Common7\IDE\Extensions\Microsoft\ManagedProjectSystem\Microsoft.VisualStudio.ProjectSystem.Managed.VS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.ProjectSystem.Managed"
               Condition="Exists('$(EffectiveVsInstallRoot)\Common7\IDE\Extensions\Microsoft\ManagedProjectSystem\Microsoft.VisualStudio.ProjectSystem.Managed.dll')">
      <HintPath>$(EffectiveVsInstallRoot)\Common7\IDE\Extensions\Microsoft\ManagedProjectSystem\Microsoft.VisualStudio.ProjectSystem.Managed.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="icon.png"
             IncludeInVSIX="true"
             VSIXSubPath="." />
  </ItemGroup>

</Project>
